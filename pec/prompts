import csv
import os
from collections import defaultdict
from datetime import date

ARCHIVO = "datos.csv"
CAMPOS = ["MONTO", "CATEGORIA", "FECHA"]  # ‑‑> usa los mismos nombres siempre

def guardar_datos(monto, categoria, fecha=""):
    """Añade un gasto al CSV.  Crea cabecera si el archivo está vacío."""
    if not fecha:
        fecha = date.today().isoformat()

    # Abrimos en append sin saltos extra
    with open(ARCHIVO, mode="a", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=CAMPOS)

        # Si el archivo está vacío, escribe la cabecera
        if f.tell() == 0:
            writer.writeheader()

        writer.writerow({"MONTO": monto, "CATEGORIA": categoria, "FECHA": fecha})


def mostrar_gastos(detalle=False):
    """
    Si detalle=True devuelve la lista completa de gastos;
    si detalle=False devuelve un resumen por categoría.
    """
    if not os.path.exists(ARCHIVO):
        return "Aún no hay registros."

    totales = defaultdict(float)
    filas = []

    with open(ARCHIVO, "r", encoding="utf-8") as f:
        lector = csv.DictReader(f)
        for fila in lector:
            # Guarda para modo detallado
            filas.append(f"{fila['FECHA']} | {fila['CATEGORIA']} | ${fila['MONTO']}")
            # Suma para modo resumen
            try:
                totales[fila["CATEGORIA"]] += float(fila["MONTO"])
            except ValueError:
                pass  # ignora montos no numéricos

    if detalle:
        return "\n".join(filas) or "Aún no hay registros."

    # Formatea resumen
    if not totales:
        return "Aún no hay registros."

    lineas = [f"{cat}: ${totales[cat]:.2f}" for cat in sorted(totales)]
    return "\n".join(lineas)
Cambios clave
writer.writerow en vez de writerows.

Cabecera: writer.writeheader() sólo si el archivo está vacío (f.tell()==0).

defaultdict(float) para acumular montos.

Control de detalle para elegir entre lista completa o tabla de totales.

newline="" y encoding="utf‑8" evitan líneas en blanco y problemas de tildes.

